{
  "flush_timeout": {
    "description": "消息聚合等待时间（秒）",
    "type": "float",
    "default": 5.0
  },

  "history_limit": {
    "description": "注入历史消息数量",
    "type": "int",
    "default": 20
  },

  "command_prefixes": {
    "description": "命令前缀",
    "type": "list",
    "default": ["/"]
  },

  "debug_log": {
    "description": "启用调试日志",
    "type": "bool",
    "default": false
  },
  
  
  "group_mode": {
    "type": "string",
    "description": "群聊过滤模式",
    "default": "off",
    "options": [
      "off",
      "whitelist",
      "blacklist"
    ]
  },

  "group_list": {
    "type": "list",
    "description": "群号列表",
    "default": []
  },

  "auto_flush_endings": {
    "type": "list",
    "description": "检测到这些结尾时立即提交",
    "default": [
      "！",
      "？",
      "!",
      "?"
    ]
  }
}
